// LAV Nextflow Parameters Configuration
// Mirrors EV_parameters.config layout (paths relative to LAV_analysis/ launch dir)
// ─────────────────────────────────────────────────────────────────────────────

// Include the generic AnalysisToolbox base config (process resources, executor, etc.)
includeConfig '../../AnalysisToolbox/Python/utils/nextflow.config'

// Git commit author configuration
params.git_user_name  = 'LAV Pipeline'
params.git_user_email = 'lav-pipeline@automated.local'

// ── Input / Output ────────────────────────────────────────────────────────
// Paths are relative to the pipeline launch directory (LAV_analysis/)
params.input_dir           = '../LAV_data'
params.output_dir          = '../LAV_results'
params.procedure_html_dir  = '.'
params.participant_pattern = 'LAV_*'
params.project_name        = 'LAV'

// L2 (cross-country) analyses are enabled
params.l2_analyses = true

// Redirect Nextflow trace into LAV_results/.bin/ so it lives alongside results
trace {
    enabled = true
    file    = "../LAV_results/.bin/pipeline_trace.txt"
}

// ── Python environment ────────────────────────────────────────────────────
// Override python_exe and venv_path for your local environment if needed
params.python_exe  = 'python3'
params.venv_path   = ''

// ── AnalysisToolbox paths (shared utilities) ──────────────────────────────
params.toolbox_dir                = '../../AnalysisToolbox/Python'
params.file_finder_script         = '../../AnalysisToolbox/Python/utils/file_finder.py'
params.interactive_plotter_script = '../../AnalysisToolbox/Python/utils/interactive_plotter.py'
params.git_sync_script            = '../../AnalysisToolbox/Python/utils/git_sync.py'

// ── LAV-specific script paths ─────────────────────────────────────────────
params.api_reader_script              = '../Python/readers/api_reader.py'
params.normalizing_processor_script   = '../Python/processors/normalizing_processor.py'
params.ols_analyzer_script            = '../Python/lav_run.py'
params.volt_report_analyzer_script    = '../Python/lav_run.py'

// ── Visualization label map (used by IOInterface auto-plotter) ────────────
params.vis_label_map = '{"lav": "LAV", "eu": "EU", "displacement": "Displacement", "trend": "Trend", "adpi": "ADPI", "drs": "DRS"}'
