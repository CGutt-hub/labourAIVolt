# LAV_results/.gitignore
# Mirrors EV_results layout: parquet result files ARE committed so that
# analysis outputs are versioned and accessible via GitHub Actions artifacts.
# Only large/noisy infrastructure files are excluded.

# Pipeline execution logs (large, regenerated on every run)
pipeline_trace.txt
nextflow.log
.nextflow/
work/

# Interactive HTML archive (large binary, regenerated by interactive_plotter)
*.html

# Keep the placeholder and this ignore file
!.gitkeep
!.gitignore
